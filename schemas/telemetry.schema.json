{
  "$defs": {
    "ErrorOwner": {
      "enum": [
        "data",
        "trainer",
        "runtime",
        "control",
        "infrastructure",
        "tracking",
        "serving",
        "unknown"
      ],
      "title": "ErrorOwner",
      "type": "string"
    },
    "ErrorRecord": {
      "additionalProperties": false,
      "description": "Failure taxonomy record preserving ownership and uncertainty.",
      "properties": {
        "code": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "config_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reference"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Error Id",
          "type": "string"
        },
        "error_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "image_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Digest"
        },
        "job_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Name"
        },
        "log_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Log Ref"
        },
        "message": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "owner": {
          "$ref": "#/$defs/ErrorOwner"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "stage": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Stage",
          "type": "string"
        },
        "uncertain": {
          "default": false,
          "title": "Uncertain",
          "type": "boolean"
        }
      },
      "required": [
        "error_id",
        "code",
        "owner",
        "message",
        "stage",
        "occurred_at"
      ],
      "title": "ErrorRecord",
      "type": "object"
    },
    "ErrorRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "error",
          "default": "error",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "title": "ErrorRef",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "description": "Content-addressed reference to an authoritative platform record.\n\nReferences intentionally carry identity and integrity separately from the\nrecord they point at.  Consumers can therefore resolve a record and verify\nits bytes before using it, while local fixtures may omit the optional URI.",
      "properties": {
        "id": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "kind",
        "id",
        "sha256"
      ],
      "title": "Reference",
      "type": "object"
    },
    "TelemetryRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "telemetry",
          "default": "telemetry",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "title": "TelemetryRef",
      "type": "object"
    },
    "TelemetrySeverity": {
      "enum": [
        "DEBUG",
        "INFO",
        "WARNING",
        "ERROR",
        "CRITICAL"
      ],
      "title": "TelemetrySeverity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Versioned structured event suitable for stdout, OTLP, or Loki adapters.",
  "properties": {
    "component": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Component",
      "type": "string"
    },
    "context": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Context",
      "type": "object"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "event": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Event",
      "type": "string"
    },
    "event_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "message": {
      "default": "",
      "title": "Message",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "references": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "title": "References",
      "type": "array"
    },
    "schema_version": {
      "default": 1,
      "minimum": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "severity": {
      "$ref": "#/$defs/TelemetrySeverity",
      "default": "INFO"
    },
    "telemetry_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/TelemetryRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "event_id",
    "occurred_at",
    "component",
    "event"
  ],
  "title": "TelemetryEvent",
  "type": "object"
}
