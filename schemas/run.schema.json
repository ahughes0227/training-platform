{
  "$defs": {
    "RunState": {
      "enum": [
        "pending",
        "preparing",
        "submitted",
        "running",
        "succeeded",
        "failed",
        "canceled"
      ],
      "title": "RunState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "catalog_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Catalog Sha256"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dataset_semantic_sha256": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataset Semantic Sha256"
    },
    "dataset_version_id": {
      "title": "Dataset Version Id",
      "type": "string"
    },
    "experiment_id": {
      "title": "Experiment Id",
      "type": "string"
    },
    "failure_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Code"
    },
    "failure_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Message"
    },
    "logs_uri": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Logs Uri"
    },
    "mlflow_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mlflow Run Id"
    },
    "object_slug": {
      "title": "Object Slug",
      "type": "string"
    },
    "output_uri": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Uri"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "runtime_id": {
      "title": "Runtime Id",
      "type": "string"
    },
    "runtime_image_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runtime Image Digest"
    },
    "runtime_source_commit": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runtime Source Commit"
    },
    "state": {
      "$ref": "#/$defs/RunState"
    },
    "vertex_job_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vertex Job Name"
    }
  },
  "required": [
    "run_id",
    "object_slug",
    "experiment_id",
    "dataset_version_id",
    "runtime_id",
    "state",
    "created_at"
  ],
  "title": "RunRecord",
  "type": "object"
}
