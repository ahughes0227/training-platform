{
  "$defs": {
    "ComponentRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "component",
          "default": "component",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "title": "ComponentRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A catalog entry for a separately owned executable/service component.",
  "properties": {
    "capabilities": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "component_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Component Id",
      "type": "string"
    },
    "display_name": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "kind": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "owner": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Owner",
      "type": "string"
    },
    "reference": {
      "$ref": "#/$defs/ComponentRef"
    },
    "version": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "component_id",
    "display_name",
    "owner",
    "kind",
    "version",
    "reference"
  ],
  "title": "ComponentDefinition",
  "type": "object"
}
