{
  "$defs": {
    "ErrorRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "error",
          "default": "error",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "title": "ErrorRef",
      "type": "object"
    },
    "LifecycleState": {
      "enum": [
        "pending",
        "queued",
        "running",
        "succeeded",
        "failed",
        "canceled",
        "blocked",
        "unknown"
      ],
      "title": "LifecycleState",
      "type": "string"
    },
    "Reference": {
      "additionalProperties": false,
      "description": "Content-addressed reference to an authoritative platform record.\n\nReferences intentionally carry identity and integrity separately from the\nrecord they point at.  Consumers can therefore resolve a record and verify\nits bytes before using it, while local fixtures may omit the optional URI.",
      "properties": {
        "id": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "default": 1,
          "minimum": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[a-fA-F0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "kind",
        "id",
        "sha256"
      ],
      "title": "Reference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Durable, truthful status projection for a referenced operation.",
  "properties": {
    "error_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "message": {
      "default": "",
      "title": "Message",
      "type": "string"
    },
    "next_action": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Action"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "references": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "title": "References",
      "type": "array"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "state": {
      "$ref": "#/$defs/LifecycleState"
    },
    "status_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Status Id",
      "type": "string"
    }
  },
  "required": [
    "status_id",
    "state",
    "observed_at"
  ],
  "title": "StatusRecord",
  "type": "object"
}
