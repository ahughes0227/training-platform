        "type": "string"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "component_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ComponentRef"
      },
      "title": "Component Refs",
      "type": "array"
    },
    "display_name": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Display Name",
      "type": "string"
    },
    "expires_at": {
